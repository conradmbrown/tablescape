# Template: replace /path/to/scape-tabletop and configure the environment before installing.
[Unit]
Description=Lost City tabletop scene API
After=scape-lostcity-export.service
Wants=scape-lostcity-export.service

[Service]
EnvironmentFile=%h/.config/tablescape/runtime.env
Type=simple
WorkingDirectory=/path/to/scape-tabletop
ExecStart=/usr/bin/python3 /path/to/scape-tabletop/service/server.py --scene /path/to/scape-tabletop/data/lostcity-scene.json --port 8768
Restart=on-failure
RestartSec=5
StandardOutput=append:/path/to/scape-tabletop/Saved/scape-lostcity-api.log
StandardError=inherit

[Install]
WantedBy=default.target
